with "config/demo_config.gpr";
project Server is

   for Source_Dirs use ("both/", "server/");
   for Object_Dir use "obj/server/" & Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("server.adb");

   package Compiler is
      for Default_Switches ("Ada") use Demo_Config.Ada_Compiler_Switches;
      for Switches ("api.adb") use Demo_Config.Ada_Compiler_Switches & "-gnatzr";
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Server;
