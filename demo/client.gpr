with "config/demo_config.gpr";
project Client is

   for Source_Dirs use ("both/", "client/");
   for Object_Dir use "obj/client/" & Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("client.adb");

   --  for Excluded_Source_Files use ("api.adb");

   package Compiler is
      for Default_Switches ("Ada") use Demo_Config.Ada_Compiler_Switches;
      for Switches ("api.ads") use Demo_Config.Ada_Compiler_Switches & "-gnatzc";
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Client;
